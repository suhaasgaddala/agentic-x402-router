# Buyer script — Base Sepolia burner wallet only. Never use a mainnet key.
EVM_PRIVATE_KEY=0xYOUR_BURNER_PRIVATE_KEY

# Buyer script — defaults to the Railway production market-signal URL
PAID_ENDPOINT_URL=https://agentic-x402-router-production.up.railway.app/v1/market-signal

PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

X402_ENABLED=false
X402_PAY_TO=0xYourWalletAddress
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=https://x402.org/facilitator
CDP_API_KEY_ID=
# CDP_API_KEY_SECRET: plain-text PEM with escaped \n sequences (local dev)
CDP_API_KEY_SECRET=
# CDP_API_KEY_SECRET_B64: base64-encoded PEM (recommended for Railway to avoid newline mangling)
# Generate with: base64 -i cdp_key.pem | tr -d '\n'
CDP_API_KEY_SECRET_B64=
X402_DEFAULT_PRICE_USD=0.05
X402_RESOURCE_BASE_URL=
X402_SERVICE_NAME=x402-model-gateway
X402_SERVICE_DESCRIPTION=x402-paid model gateway for agent-discoverable LLM inference

# Coinbase CDP facilitator auth.
# Required when X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# If the secret is a PEM value in hosted env vars, escaped \n sequences are normalized at startup.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

ANTHROPIC_API_KEY=

MAX_INPUT_CHARS=50000
MAX_OUTPUT_TOKENS=2000
JSON_BODY_LIMIT=1mb

PRICE_MARKET_SIGNAL_USD=0.02
COST_MARKET_SIGNAL_PROVIDER_USD=0.005
MARKET_SIGNAL_PROVIDER=mock
DEXSCREENER_BASE_URL=https://api.dexscreener.com
MARKET_SIGNAL_PROVIDER_TIMEOUT_MS=5000
COST_MARKET_SIGNAL_DEXSCREENER_USD=0

PRICE_CLAUDE_HAIKU_USD=0.02
PRICE_CLAUDE_SONNET_USD=0.05
PRICE_CLAUDE_OPUS_USD=0.20
PRICE_MOCK_FAST_USD=0.001
DEFAULT_PRICE_USD=0.05

COST_CLAUDE_HAIKU_INPUT_PER_MTOK_USD=1
COST_CLAUDE_HAIKU_OUTPUT_PER_MTOK_USD=5
COST_CLAUDE_SONNET_INPUT_PER_MTOK_USD=3
COST_CLAUDE_SONNET_OUTPUT_PER_MTOK_USD=15
COST_CLAUDE_OPUS_INPUT_PER_MTOK_USD=15
COST_CLAUDE_OPUS_OUTPUT_PER_MTOK_USD=75
